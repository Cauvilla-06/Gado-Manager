TURSO_DATABASE_URL="libsql://NOME_DO_BANCO.turso.io"
TURSO_AUTH_TOKEN="cole_seu_token_aqui"

# Segredo que assina os tokens de login. OBRIGATÓRIO trocar: o servidor
# recusa este valor de exemplo e qualquer valor com menos de 32 caracteres.
# Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET="mude_este_secret_em_producao"

# (Opcional) IPs/hosts extras que podem acessar o servidor de desenvolvimento,
# separados por vírgula. Ex.: o IP do PC na rede local, para testar pelo celular.
# DEV_ALLOWED_ORIGINS="192.168.1.175"
